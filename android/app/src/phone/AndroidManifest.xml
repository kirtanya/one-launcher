<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Runs Google's Home permission flow (account picker + "allow access to devices").
             MainActivity is a plain FlutterActivity, so the flow needs a ComponentActivity. -->
        <activity
            android:name=".HomeConnectActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
