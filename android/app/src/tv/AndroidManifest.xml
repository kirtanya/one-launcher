<!-- One Launcher TV: merged over src/main. Swaps the phone home screen for the TV one. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- A TV app: no touchscreen needed, shows up in the TV's app row. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <!-- Streaming apps' Watch Next / channels. Android grants other apps' rows only to the TV's
         system launcher; where a TV allows more, those rows appear. -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA"/>
    <!-- Shows & films search (Stremio addon catalogs, WatchHub links) and artwork -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Quick action "Free up memory": stop other apps' background processes. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES"/>
    <!-- Quick action "Speed up": opening Android's "Clear app cache?" screen needs All files access. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage"/>
    <!-- Brightness from the phone's remote (granted once: "Modify system settings") -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions"/>
    <application
        android:label="One Launcher TV"
        android:banner="@drawable/tv_banner"
        tools:replace="android:label">
        <!-- Phone-only parts (MediaListener stays: "Continue watching" reads the playing show) -->
        <activity android:name=".MainActivity" tools:node="remove"/>

        <activity
            android:name=".TvActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:screenOrientation="landscape"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustNothing">
            <meta-data android:name="io.flutter.embedding.android.NormalTheme" android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
            <!-- Lets the TV use One Launcher TV as its home screen -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <!-- Read show names (Customise → Remote & behaviour): off until switched on in
             Accessibility settings. See ShowNameService.kt. -->
        <service
            android:name=".ShowNameService"
            android:exported="false"
            android:label="One Launcher TV: read show names"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/show_names" />
        </service>
        <!-- Invisible: the phone remote opens onelauncher://picture (the TV's picture panel),
             onelauncher://brightness?level=N or onelauncher://launch?package=P (its quick apps;
             see BrightnessActivity.kt). -->
        <activity
            android:name=".BrightnessActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="onelauncher" android:host="brightness"/>
                <data android:scheme="onelauncher" android:host="picture"/>
                <data android:scheme="onelauncher" android:host="launch"/>
            </intent-filter>
        </activity>
    </application>
    <queries>
        <!-- See every TV app -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
        </intent>
        <!-- A show's page: "Open in Nuvio" (apps that open stremio:// / nuvio:// details) -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="stremio"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="nuvio"/>
        </intent>
    </queries>
</manifest>
